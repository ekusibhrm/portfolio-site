# Vercel CLI falls back to .gitignore for upload exclusions when this
# file is absent, which was hiding the private pricing route (kept out
# of git on purpose) from every `vercel --prod` deploy too. Listing the
# normal exclusions here explicitly, without that route, fixes it.
/node_modules
/.next/
/out/
/build
/coverage
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
.vercel
*.tsbuildinfo

# source material for private pages — not needed at runtime
/docs/
